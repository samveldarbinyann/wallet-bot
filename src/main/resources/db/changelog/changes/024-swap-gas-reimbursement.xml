<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="024-swap-gas-reimbursement" author="launch-prep">
        <addColumn tableName="swap_orders">
            <column name="gas_sponsored" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="gas_reimbursement" type="NUMERIC(30,18)"/>
            <column name="gas_reimbursement_tx_hash" type="VARCHAR(128)"/>
            <column name="gas_sponsorship_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
