<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-notification-channel-prefs" author="admin">
        <addColumn tableName="users">
            <column name="notify_push_enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropColumn tableName="users" columnName="notify_send_success"/>
        <dropColumn tableName="users" columnName="notify_deposit"/>
        <dropColumn tableName="users" columnName="notify_app_update"/>
        <dropColumn tableName="users" columnName="notify_news"/>
    </changeSet>

</databaseChangeLog>
