<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="031-refresh-tokens" author="security-audit">
        <comment>
            Refresh-token table to support the 15-minute access JWT + 30-day refresh
            rotation flow (H-11). token_hash is SHA-256 hex of a 32-byte random token
            handed back to the client once.
        </comment>

        <createTable tableName="refresh_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="issued_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="revoked_at" type="TIMESTAMP"/>
            <column name="replaced_by_id" type="BIGINT"/>
        </createTable>

        <createIndex tableName="refresh_tokens" indexName="ix_refresh_tokens_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="refresh_tokens" indexName="ix_refresh_tokens_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
